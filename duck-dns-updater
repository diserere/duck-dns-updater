#!/usr/bin/env bash
# Скрипт для регулярного обновления динамических записей на DuckDNS.
# Сервер в случае успешного обновления возвращает ответ "OK". В случае неуспешного - ответ "KO".
# Документация DuckDNS: https://www.duckdns.org/spec.jsp
#
# Чтобы вывести готовую строку crontab с абсолютным путём, запустите скрипт с флагом `--print-cronjob`.

# TODO: Научиться обрабатывать ошибки Bad Gateway, которые оставляют в логе вот такие сообщения:
# 
# 2026-11-05 11:00:01+03:00|0|<html>
#  <head><title>502 Bad Gateway</title></head>
#  <body>
#  <center><h1>502 Bad Gateway</h1></center>
#  </body>
#  </html>

# TODO: научиться обрабатывать ответ сервера из заголовков, и включать его тоже в лог. Само сообщение включать в лог только если код ответа 200.
# Это будет более изящное решение, чем парсить тексты ошибок типа Бэдгейтвей из тела ответа.
# Вот пример ответа:
# 
# HTTP/2 200 
# date: Thu, 05 Nov 2026 03:54:02 GMT
# set-cookie: AWSALB=u2Vm9qY5gXrstLUWcn5IqKZysOElM4icDrrntViSJ4Lfb3zKBvFOGQFBvgNL3OI0ycdIJ3i7bTftVI9dEdD/OBZ7unaSxmIOjYzaxQZba2N6hkCUBbU9KwEuxEHr; Expires=Thu, 12 Nov 2026 03:54:02 GMT; Path=/
# set-cookie: AWSALBCORS=u2Vm9qY5gXrstLUWcn5IqKZysOElM4icDrrntViSJ4Lfb3zKBvFOGQFBvgNL3OI0ycdIJ3i7bTftVI9dEdD/OBZ7unaSxmIOjYzaxQZba2N6hkCUBbU9KwEuxEHr; Expires=Thu, 12 Nov 2026 03:54:02 GMT; Path=/; SameSite=None; Secure
# server: nginx/1.30.3
# x-clacks-overhead: GNU Terry Pratchett
# x-frame-options: DENY
# 
# OK 188.244.39.72 NOCHANGE


SCRIPT_SOURCE="${BASH_SOURCE[0]}"
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_SOURCE")" && pwd)"
SCRIPT_PATH="${SCRIPT_DIR}/$(basename -- "$SCRIPT_SOURCE")"

usage() {
    cat <<'HELP'
Использование: duck-dns-updater [ФЛАГИ]

Режимы:
  -p, --print-cronjob   Вывести готовую строку cronjob.
  -l, --list-journal    Показать журнал.
  -R, --reset-journal   Очистить журнал.
  -h, --help            Показать эту справку.

Флаги обновления:
  -tz, --timezone ЗОНА  Задать часовую зону для отметки времени.
  -v, --verbose         Запросить подробный ответ DuckDNS.
  -j, --journal         Добавлять результаты в журнал.
  -u, --updates-only    Не выводить ответы NOCHANGE.

Флаги обновления можно указывать в любом порядке. -u действует и при
выводе в консоль, и при записи в журнал. Для режимов -p, -l и -R
нельзя указывать другие флаги.

Примеры:
  duck-dns-updater --verbose --journal --updates-only
  duck-dns-updater --timezone Europe/Moscow --verbose
  duck-dns-updater --print-cronjob
  duck-dns-updater --list-journal
HELP
}

usage_error() {
    printf 'Ошибка: %s\n\n' "$1" >&2
    usage >&2
    exit 2
}

set_mode() {
    if [[ -n "$ARG_MODE" ]]; then
        usage_error "режимы командной строки нельзя сочетать"
    fi
    ARG_MODE="$1"
}

ARG_MODE=""
ARG_VERBOSE=0
ARG_JOURNAL=0
ARG_UPDATES_ONLY=0
ARG_TZ_SET=0
ARG_TZ=""

while (($# > 0)); do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -p|--print-cronjob)
            set_mode "print-cronjob"
            shift
            ;;
        -l|--list-journal)
            set_mode "list-journal"
            shift
            ;;
        -R|--reset-journal)
            set_mode "reset-journal"
            shift
            ;;
        -tz|--timezone)
            if (($# < 2)) || [[ -z "$2" || "$2" == -* ]]; then
                usage_error "для $1 нужно указать часовую зону"
            fi
            ARG_TZ="$2"
            ARG_TZ_SET=1
            shift 2
            ;;
        -v|--verbose)
            ARG_VERBOSE=1
            shift
            ;;
        -j|--journal)
            ARG_JOURNAL=1
            shift
            ;;
        -u|--updates-only)
            ARG_UPDATES_ONLY=1
            shift
            ;;
        *)
            usage_error "неизвестный флаг или лишнее значение: $1"
            ;;
    esac
done

if [[ -n "$ARG_MODE" ]] && ((ARG_VERBOSE || ARG_JOURNAL || ARG_UPDATES_ONLY || ARG_TZ_SET)); then
    usage_error "режимы командной строки нельзя сочетать с флагами обновления"
fi

if [[ "$ARG_MODE" == "print-cronjob" ]]; then
    printf -v CRON_SCRIPT_PATH '%q' "$SCRIPT_PATH"
    printf '*/5 * * * * %s --verbose --journal --updates-only >/dev/null 2>&1\n' "$CRON_SCRIPT_PATH"
    exit 0
fi

# Безопасные плейсхолдеры для переменных.
DOMAINS="exampledomain,anotherdomain"
TOKEN="DUCKDNS-USER-TOKEN"
IP=""

# Не храните персональные данные, такие как обновляемые домены и токен доступа,
# в самом скрипте, если вы сохраняете его в репозитории git.
# Поместите их в отдельный файл .env, расположенный в той же директории, что и скрипт.
ENV_FILE="${SCRIPT_DIR}/.env"
if [[ -f "$ENV_FILE" ]]; then
    # .env — доверенный Bash-конфиг: source выполняет команды из файла.
    source "$ENV_FILE"
fi

if ((ARG_TZ_SET)); then
    TZ="$ARG_TZ"
fi

LOG_DIR="${SCRIPT_DIR}/logs"
LOG_FILE="${LOG_DIR}/$(basename -- "$SCRIPT_SOURCE").log"

VERBOSE=""
if ((ARG_VERBOSE)); then
    VERBOSE="&verbose=true"
fi

case "$ARG_MODE" in
    list-journal)
        if [[ -f "$LOG_FILE" ]]; then
            echo
            echo "Журнал обновления записей DuckDNS для доменных имён: ${DOMAINS}"
            echo
            column -t -N "DATE,CODE,STATUS" -R 2 -s "|" "$LOG_FILE"
        else
            echo "Ошибка: файл журнала $LOG_FILE не найден или не является обычным файлом"
        fi
        exit
        ;;
    reset-journal)
        mkdir -p "$LOG_DIR" || exit 1
        : > "$LOG_FILE"
        exit $?
        ;;
esac


UPDATE_URL="https://www.duckdns.org/update?domains=${DOMAINS}&token=${TOKEN}&ip=${IP}${VERBOSE}"

if [[ -n "${TZ:-}" ]]; then
    export TZ
else
    unset TZ
fi
DATE=$(date --rfc-3339=seconds)

RESPONSE=$(curl -s "$UPDATE_URL")
RCODE=$?

# Подробный ответ DuckDNS может содержать переводы строк; запись журнала должна оставаться однострочной.
RESPONSE="${RESPONSE//$'\r'/ }"
RESPONSE="${RESPONSE//$'\n'/ }"

OUT="${DATE}|${RCODE}|${RESPONSE:-"(no response)"}"

if ((ARG_UPDATES_ONLY == 0)) || [[ "$RESPONSE" != *NOCHANGE* ]]; then
    if ((ARG_JOURNAL)); then
        mkdir -p "$LOG_DIR" || exit 1
        printf '%s\n' "$OUT" >> "$LOG_FILE"
    else
        printf '%s\n' "$OUT"
    fi
fi
